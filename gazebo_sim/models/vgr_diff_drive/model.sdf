        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="front_caster_left">
      <pose>0.0525 0.045 0.01625 0 0 0</pose>
      <inertial>
        <mass>0.025</mass>
        <inertia>
          <ixx>2.640625e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>2.640625e-06</iyy>
          <iyz>0</iyz>
          <izz>2.640625e-06</izz>
        </inertia>
      </inertial>
      <collision name="front_caster_left_collision">
        <geometry>
          <sphere>
            <radius>0.01625</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.001</mu>
              <mu2>0.001</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="front_caster_left_visual">
        <geometry>
          <sphere>
            <radius>0.01625</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.6 0.6 0.6 1</ambient>
          <diffuse>0.6 0.6 0.6 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="front_caster_right">
      <pose>0.0525 -0.045 0.01625 0 0 0</pose>
      <inertial>
        <mass>0.025</mass>
        <inertia>
          <ixx>2.640625e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>2.640625e-06</iyy>
          <iyz>0</iyz>
          <izz>2.640625e-06</izz>
        </inertia>
      </inertial>
      <collision name="front_caster_right_collision">
        <geometry>
          <sphere>
            <radius>0.01625</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.001</mu>
              <mu2>0.001</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="front_caster_right_visual">
        <geometry>
