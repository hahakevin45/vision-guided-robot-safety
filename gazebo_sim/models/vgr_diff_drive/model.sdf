<sdf version="1.8">
  <model name="vgr_diff_drive">
    <pose>0 0 0 0 0 0</pose>
    <link name="chassis">
      <pose>0 0 0.065 0 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.006578125</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.020528125</iyy>
          <iyz>0</iyz>
          <izz>0.02605</izz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <geometry>
          <box>
            <size>0.4 0.22 0.065</size>
          </box>
        </geometry>
      </collision>
      <visual name="chassis_visual">
        <geometry>
          <box>
            <size>0.4 0.22 0.065</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.35 0.8 1</ambient>
          <diffuse>0.1 0.35 0.8 1</diffuse>
        </material>
      </visual>
      <sensor name="front_camera" type="camera">
        <pose>0.2 0 0.17 0 0 0</pose>
        <topic>/camera/image_raw</topic>
        <update_rate>15</update_rate>
        <always_on>1</always_on>
        <visualize>0</visualize>
        <camera>
          <horizontal_fov>1.2</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>10</far>
          </clip>
        </camera>
      </sensor>
    </link>
    <link name="left_wheel">
      <pose>-0.0825 0.0825 0.0325 0 0 0</pose>
      <inertial>
        <mass>0.125</mass>
        <inertia>
          <ixx>3.57584635417e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>6.6015625e-05</iyy>
          <iyz>0</iyz>
          <izz>3.57584635417e-05</izz>
        </inertia>
      </inertial>
      <collision name="left_wheel_collision">
