<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vgr_runtime</name>
  <version>0.1.0</version>
  <description>Real-robot ROS 2 nodes for VGR hardware: cmd_vel bridge, reverse cmd publisher, hardware bridge. Depends on vgr_core and vgr_driver.</description>
  <maintainer email="portfolio@users.noreply.github.com">Kevin Su</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>vgr_core</depend>
  <depend>vgr_driver</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
